{
  "name": "eva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight local-first Pi-powered personal assistant.",
  "author": "Rahul Ramesh",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm build:server && electron-vite dev",
    "dev:fake": "EVA_AGENT_MODE=fake pnpm dev",
    "dev:browser": "concurrently -k -s first \"EVA_PORT=43111 EVA_TOKEN=eva-dev-token EVA_AGENT_MODE=fake EVA_DATA_DIR=.eva-dev tsx apps/agent-server/src/index.ts\" \"vite --config vite.web.config.ts --host 127.0.0.1\"",
    "build:server": "tsup apps/agent-server/src/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean --external @earendil-works/pi-coding-agent",
    "build": "pnpm build:server && electron-vite build",
    "package": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "package:signed": "pnpm build && electron-builder --mac dir",
    "package:windows": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64",
    "package:windows:dir": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir --x64",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/cloud/tsconfig.json",
    "test": "vitest run",
    "build:web": "vite build --config vite.web.config.ts --outDir ../../../../out/web",
    "cloud:types": "wrangler types apps/cloud/src/worker-configuration.d.ts",
    "cloud:dev": "pnpm build:web && wrangler dev",
    "cloud:deploy": "pnpm build:web && wrangler deploy --minify",
    "cloud:deploy:dry": "pnpm build:web && wrangler deploy --dry-run --minify",
    "cloud:migrate:local": "wrangler d1 migrations apply eva-cloud-production --local",
    "cloud:migrate": "wrangler d1 migrations apply eva-cloud-production --remote",
    "cloud:e2e": "node scripts/cloud-e2e.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:web && pnpm cloud:deploy:dry"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.5",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@phosphor-icons/react": "^2.1.10",
    "jose": "^6.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.7",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  },
  "build": {
    "appId": "com.rahulvramesh.eva",
    "productName": "Eva",
    "asar": true,
    "electronLanguages": [
      "en"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "packageManager": "pnpm@11.8.0"
}
